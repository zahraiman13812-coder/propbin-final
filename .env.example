# Copy to .env.local. Never commit a populated environment file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARS
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
USER_AUTH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
# Configure ONE email provider before testing real login codes.
RESEND_API_KEY=
MAIL_FROM=
# Alternative email provider:
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: origin of legacy Supabase image storage (not required for PostgreSQL).
SUPABASE_URL=
DEV_MOCK_LOGIN=false
DEMO_LOGIN_ENABLED=false
